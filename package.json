{
  "name": "memory-manage-mcp",
  "version": "0.4.0",
  "description": "Local-first, database-free persistent memory MCP server. Lets any AI coding agent (VS Code, Cursor, Claude, Gemini CLI, ...) continue a project exactly where another agent left off.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "memory",
    "ai-agents",
    "context",
    "handoff",
    "local-first"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "memory-manage-mcp": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "cli": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "doctor": "node dist/cli/index.js doctor"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
